# Writes OUTPUT_FILE with two stamps of the sources under SOURCE_DIR, for the shader store header:
# - the format stamp covers the code that encodes store records and the keys they hold;
# - the translator stamp covers all graphics code, which decides what a shader becomes.
# The file is rewritten only when a stamp changes, so an unrelated change rebuilds nothing.

function(kyty_stamp out_var)
	set(lines "")
	foreach(path IN LISTS ARGN)
		file(SHA256 "${SOURCE_DIR}/${path}" digest)
		string(APPEND lines "${path} ${digest}\n")
	endforeach()
	string(SHA256 digest "${lines}")
	string(SUBSTRING "${digest}" 0 16 digest)
	set(${out_var} "0x${digest}ull" PARENT_SCOPE)
endfunction()

set(format_files
	graphics/host_gpu/renderer/pipeline/pipelineCache.h
	graphics/host_gpu/renderer/pipeline/pipelineSerialization.cpp
	graphics/shader/recompiler/ir/Serialize.h
	graphics/shader/shader.cpp
	graphics/shader/shader.h
)
kyty_stamp(format_stamp ${format_files})

if(NOT IS_ABSOLUTE "${SOURCE_DIR}" OR NOT EXISTS "${SOURCE_DIR}/graphics")
	message(FATAL_ERROR "SOURCE_DIR must be the absolute path of the source folder")
endif()
file(GLOB_RECURSE translator_files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/graphics/*")
# Module ids are hashed with it.
list(APPEND translator_files common/hash.h)
list(SORT translator_files)
kyty_stamp(translator_stamp ${translator_files})

set(content "// Generated by generate_shader_stamps.cmake.
#pragma once

#include <cstdint>

namespace Libs::Graphics::ShaderStamps {
inline constexpr uint64_t Format     = ${format_stamp};
inline constexpr uint64_t Translator = ${translator_stamp};
} // namespace Libs::Graphics::ShaderStamps
")
set(old "")
if(EXISTS "${OUTPUT_FILE}")
	file(READ "${OUTPUT_FILE}" old)
endif()
if(NOT old STREQUAL content)
	file(WRITE "${OUTPUT_FILE}" "${content}")
endif()
